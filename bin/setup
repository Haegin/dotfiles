#!/bin/bash
set -euo pipefail

DOTDIR="${HOME}/.dotfiles"

# Install asdf if not present
if [[ ! -d "$HOME/.asdf" ]]; then
  echo "Installing asdf..."
  git clone https://github.com/asdf-vm/asdf.git "$HOME/.asdf" --branch v0.14.0
fi

# Source asdf
export ASDF_DIR="$HOME/.asdf"
. "$ASDF_DIR/asdf.sh"

# Add racket plugin if not present
if ! asdf plugin list | grep -q '^racket$'; then
  echo "Adding asdf racket plugin..."
  asdf plugin add racket https://github.com/asdf-community/asdf-racket.git
fi

# Install latest racket if not present
if ! asdf list racket &>/dev/null; then
  echo "Installing latest racket..."
  latest=$(asdf list-all racket | grep -E '^[0-9]+\.[0-9]+$' | sort -V | tail -n 1)
  asdf install racket "$latest"
  asdf global racket "$latest"
fi

# Ensure racket is available
if ! command -v racket &>/dev/null; then
  echo "Racket not found in PATH after installation."
  echo "Please restart your shell or add asdf shims to your PATH."
  exit 1
fi

# Run the racket setup script
exec racket "${DOTDIR}/bin/setup.rkt"
